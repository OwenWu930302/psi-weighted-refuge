>     def __init__(self, base, names, cases, factor):
>         self.base = base
>         self.w = np.array([factor if n in cases else 1.0 for n in names], dtype=np.float32)
> 
>     def __len__(self):
>         return len(self.base)
> 
>     def __getitem__(self, idx):
>         x, y = self.base[idx]
>         return x, y, torch.tensor(self.w[idx])
